flowchart TD
    subgraph U["用户端（读者 / 作者）"]
        direction TB
        U1([打开内容页]) --> U2["浏览评论 · 热评"]
        U2 --> U3["发表评论 / 回复"]
        U2 --> U4["点赞 / 取消赞"]
        U7["查看站内通知"] --> U8["单条 / 全部已读"]
    end

    subgraph S["服务端（评论中心）"]
        direction TB
        S1["落库 audit=0 待审"] --> S2["事务提交后发事件"]
        S2 --> S3["异步监听: 通知·热评·缓存"]
        S5["点赞表 + Redis 计数"] --> S6["发布点赞事件"]
        S6 --> S3
        S7["更新审核状态"]
    end

    subgraph M["审核端（机审 / 人工）"]
        direction TB
        M1["拉取待审内容"] --> M2{是否违规}
        M2 -->|正常| M3["回调: 通过=1"]
        M2 -->|违规| M4["回调: 拒绝=2"]
    end

    U3 --> S1
    S1 -->|待审池| M1
    M3 --> S7
    M4 --> S7
    S7 -->|全员可见| U2
    S7 -.->|仅作者可见| U2
    U4 --> S5
    S3 -.->|被回复 / 被赞通知| U7
    L["状态机: 0待审 → 1通过 → 2拒绝（当前先审后发，可切先发后审）"]
    S7 -.- L
